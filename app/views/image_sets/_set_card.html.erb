<div class="rounded-lg border border-gray-200 px-4 py-3 flex items-center justify-between gap-3">
  <div class="min-w-0 flex-1">
    <%= link_to set.name, set, class: "font-medium text-gray-900 hover:text-blue-600 truncate block" %>
    <p class="text-xs text-gray-500 mt-0.5">
      <%= set.respond_to?(:items_count) ? set.items_count : set.image_set_items.count %> images &middot;
      <span class="<%= set.visibility == 'public' ? 'text-green-600' : 'text-gray-500' %>"><%= set.visibility %></span>
      <% if set.filtered? %>
        &middot; <span class="text-forest-600">Filtered</span>
      <% end %>
    </p>
    <% if set.tags.any? %>
      <% tag_match = local_assigns.fetch(:tag_match, "all") %>
      <% tag_case = local_assigns.fetch(:tag_case, "insensitive") %>
      <% selected_tags =
        if tag_case == "sensitive"
          ImageSet.normalize_tag_names(local_assigns[:selected_tags])
        else
          ImageSet.normalize_tag_slugs(local_assigns[:selected_tags])
        end %>
      <% filter_sort = local_assigns[:sort] %>
      <% filter_direction = local_assigns[:direction] %>
      <div class="flex flex-wrap gap-1 mt-2">
        <% set.tags.order(:name).each do |tag| %>
          <% tag_filter_value = tag_case == "sensitive" ? tag.name : tag.slug %>
          <% filter_tags = (selected_tags + [ tag_filter_value ]).uniq %>
          <% tag_filter_path = { tags: filter_tags } %>
          <% tag_filter_path[:tag_match] = tag_match if filter_tags.any? && local_assigns.key?(:tag_match) %>
          <% tag_filter_path[:tag_case] = tag_case if local_assigns.key?(:tag_case) %>
          <% tag_filter_path[:sort] = filter_sort if filter_sort.present? %>
          <% tag_filter_path[:direction] = filter_direction if filter_direction.present? %>
          <%= link_to tag.name, image_sets_path(tag_filter_path),
                class: "inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-forest-50 text-forest-700 hover:bg-forest-100 border border-forest-200" %>
        <% end %>
      </div>
    <% end %>
  </div>
  <div class="flex items-center gap-2 shrink-0">
    <% if practice_image_set?(set) %>
      <%= link_to "Practice", practice_path(practice_set_id: set.id), class: "btn-primary text-sm py-1.5" %>
    <% else %>
      <%= button_to "Play", games_path, method: :post,
            params: { image_set_id: set.id },
            class: "btn-primary text-sm py-1.5" %>
      <% set_items_count = set.respond_to?(:items_count) ? set.items_count : set.image_set_items.count %>
      <% if email_verified? && set_items_count.positive? %>
        <%= link_to "Practice", practice_path(practice_set_id: set.id), class: "btn-secondary text-sm py-1.5" %>
      <% end %>
    <% end %>
    <div data-controller="dropdown" class="relative">
      <button type="button" data-action="click->dropdown#toggle"
              aria-label="More actions"
              class="btn-secondary text-sm py-1.5 px-3 inline-flex items-center justify-center">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M6 12a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0z"/>
        </svg>
      </button>
      <div data-dropdown-target="menu"
           class="hidden absolute right-0 top-full mt-1 z-10 min-w-[10rem] rounded-md border border-gray-200 bg-white shadow-lg py-1">
        <% unless practice_image_set?(set) %>
          <%= link_to "Leaderboard", leaderboard_games_path(image_set_id: set.id),
                class: "block px-3 py-2 text-sm text-gray-700 hover:bg-gray-50" %>
        <% end %>
        <%= link_to "Map", map_image_set_path(set),
              class: "block px-3 py-2 text-sm text-gray-700 hover:bg-gray-50" %>
        <% if local_assigns[:show_owner_actions] %>
          <div class="border-t border-gray-100 my-1"></div>
          <% if set.filtered? %>
            <%= link_to "Edit filter", edit_filter_image_set_path(set),
                  class: "block px-3 py-2 text-sm text-gray-700 hover:bg-gray-50" %>
          <% else %>
            <%= link_to "Manage images", locations_image_set_path(set),
                  class: "block px-3 py-2 text-sm text-gray-700 hover:bg-gray-50" %>
            <%= link_to "New filtered set", new_filtered_image_set_path(set),
                  class: "block px-3 py-2 text-sm text-gray-700 hover:bg-gray-50" %>
          <% end %>
          <%= link_to "Settings", edit_image_set_path(set),
                class: "block px-3 py-2 text-sm text-gray-700 hover:bg-gray-50" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
