<%# Completed generation: preview card + "Import images" form. The AI's
    SPARQL pattern and other fields are server-controlled (they come
    from the AiGeneration record), so importing reuses the exact query
    the user just previewed — a tampered hidden field can't smuggle
    malicious SPARQL past parse_submit's validation. %>
<% result = generation.result || {} %>
<% preview = generation.preview %>
<% count   = generation.result_count %>
<% source  = (result[:image_source] || "wikidata").to_s %>

<section class="card p-4 space-y-4">
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="eyebrow">Proposed set</p>
      <h2 class="text-xl font-semibold text-forest-900 mt-1"><%= result[:set_name] %></h2>
      <div class="mt-1"><%= source_pill(source) %></div>
    </div>
    <div class="text-right text-sm">
      <% if count.nil? %>
        <p class="text-amber-700">Couldn't count yet</p>
      <% else %>
        <%# "Up to" because the count is an estimate the import step refines
            down (polygon refinement, photo availability, dedup, per-sequence
            capping for Mapillary). Copy is source-specific so a street-imagery
            or photo set doesn't claim "matching items / per category". %>
        <% case source
           when "mapillary" %>
          <p><strong class="text-forest-900">Up to <%= number_with_delimiter(count) %></strong> street images</p>
          <p class="muted">Sampled across the region (max <%= number_with_delimiter(MapillaryImporter::HARD_CAP) %>)</p>
        <% when "commons" %>
          <p><strong class="text-forest-900">Up to <%= number_with_delimiter(count) %></strong> photos</p>
          <p class="muted">Geotagged Commons photos (max 10,000, random)</p>
        <% else %>
          <p><strong class="text-forest-900">Up to <%= number_with_delimiter(count) %></strong> matching items</p>
          <p class="muted">Imports up to 10,000 per category (random)</p>
        <% end %>
      <% end %>
    </div>
  </div>

  <p class="text-sm text-forest-900">
    <span class="eyebrow mr-1">AI</span>
    <%= result[:explanation] %>
  </p>

  <%# Sample thumbnails. ?width=400 matches show-page's image_src
      width so the browser cache can reuse them. %>
  <% if preview.any? %>
    <div>
      <p class="eyebrow mb-2">Sample (<%= preview.size %> of <%= count || "?" %>)</p>
      <div class="grid grid-cols-3 sm:grid-cols-5 gap-2">
        <% preview.each do |row| %>
          <% row_src = row[:url].present? ? (row[:external_source].to_s == "mapillary" ? row[:url] : "#{row[:url]}?width=400") : nil %>
          <%# Link out only when we actually have a URL. A Mapillary signed
              URL that failed to resolve would otherwise render href="" and
              reload the current page on click — render a plain div instead. %>
          <% tag_name = row[:url].present? ? :a : :div %>
          <% link_attrs = row[:url].present? ? { href: row[:url], target: "_blank", rel: "noopener" } : {} %>
          <%= content_tag tag_name, **link_attrs, title: row[:title],
                data: { controller: "hide-broken-image" },
                class: "group relative block aspect-square overflow-hidden rounded-md bg-forest-50 border border-forest-100" do %>
            <% if row_src.present? %>
              <img src="<%= row_src %>"
                   alt="<%= row[:title] %>"
                   loading="lazy"
                   class="w-full h-full object-cover transition group-hover:opacity-90" />
            <% end %>
            <% if row[:title].present? %>
              <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/85 via-black/40 to-transparent text-white text-[11px] leading-tight font-medium px-2 py-2 opacity-0 group-hover:opacity-100 transition-opacity line-clamp-2">
                <%= row[:title] %>
              </div>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% elsif count == 0 %>
    <p class="text-sm text-amber-700">
      The AI's query matched 0 images. Try refining your prompt — be more specific
      (e.g. add a country) or use a more common category.
    </p>
  <% end %>

  <%# Import form. Only USER-controllable inputs (name, visibility) live
      here; the AI's SPARQL pattern, explanation, model, and prompt all
      come from the AiGeneration record server-side — see ai_create. %>
  <%= form_with url: ai_create_image_sets_path, local: true, class: "space-y-3 pt-2 border-t border-forest-100" do |f| %>
    <%= hidden_field_tag :generation_id, generation.id %>

    <div>
      <label class="text-sm font-medium text-forest-900">Set name</label>
      <%= text_field_tag :name, result[:set_name], class: "form-input" %>
    </div>
    <div>
      <label class="text-sm font-medium text-forest-900">Visibility</label>
      <%= select_tag :visibility, options_for_select([ [ "Private", "private" ], [ "Public", "public" ] ], "private"), class: "form-input select-with-arrow" %>
    </div>

    <% if source == "wikidata" && result[:sparql_pattern].present? %>
      <details class="text-sm">
        <summary class="cursor-pointer text-forest-700 hover:text-forest-900">Show query (advanced)</summary>
        <pre class="mt-3 p-3 bg-forest-50 border border-forest-100 rounded-md overflow-x-auto text-xs text-forest-900"><%= result[:sparql_pattern] %></pre>
      </details>
    <% end %>

    <div class="flex justify-end">
      <%= submit_tag "Import images", class: "btn-primary cursor-pointer" %>
    </div>
  <% end %>
</section>
