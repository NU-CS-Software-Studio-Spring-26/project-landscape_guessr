# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files (keep .env.example for documentation).
/.env*
!/.env.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key


/app/assets/builds/*
!/app/assets/builds/.keep

# Editor / OS
.idea/
.vscode/
.DS_Store
.claude
.playwright-mcp

# Local bundler install (kept out of git)
/vendor/bundle/

# Local-only rake tasks (personal scripts, never pushed)
/lib/tasks/local_*.rake

# For developement with AI
AGENTS.md

# Local Stripe support-button deployment notes
/stripe_support_deployment_plan/

# AI-generated test planning docs
/docs/plans/